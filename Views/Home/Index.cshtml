@{ ViewData["Title"] = "Your job search, organized"; }
<section class="hero rounded-4 p-5 mb-5 text-white overflow-hidden"><div class="row align-items-center"><div class="col-lg-7"><p class="eyebrow">THE JOB SEARCH COMPANION</p><h1 class="display-4 fw-bold">Turn every application into momentum.</h1><p class="lead my-4">Keep opportunities, interviews and documents in one calm, focused workspace.</p>@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-light btn-lg px-4" asp-controller="Applications" asp-action="Index">Open my tracker</a> } else { <a class="btn btn-light btn-lg px-4" asp-area="Identity" asp-page="/Account/Register">Start tracking free</a> }</div><div class="col-lg-5 d-none d-lg-block"><div class="hero-card shadow"><span class="text-muted small">NEXT INTERVIEW</span><h4 class="mt-2">Software Engineer Intern</h4><p class="mb-0">Thursday · 10:00 · Video call</p></div></div></div></section>
<div class="row g-4"><div class="col-md-4"><div class="feature-card"><div class="feature-number">01</div><h4>Own the process</h4><p>Track every role from wish list to offer, with no lost follow-ups.</p></div></div><div class="col-md-4"><div class="feature-card"><div class="feature-number">02</div><h4>Prepare with context</h4><p>Keep recruiter details, notes and tailored documents exactly where you need them.</p></div></div><div class="col-md-4"><div class="feature-card"><div class="feature-number">03</div><h4>See your progress</h4><p>Use simple analytics to understand your job-search pipeline.</p></div></div></div>
