@{
    ViewData["Title"] = "Your job search, organized";
}

<section class="hero rounded-4 p-5 mb-5 text-white overflow-hidden">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="eyebrow">THE JOB SEARCH COMPANION</p>
            <h1 class="display-4 fw-bold">Your job search, organized.</h1>
            <p class="lead">
                Keep every role, every contact, and every next step in one place so you can focus on what matters.
            </p>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <a href="#" class="btn btn-primary btn-lg">Start tracking</a>
                <a href="#features" class="btn btn-outline-light btn-lg">See how it works</a>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small">Pipeline overview</span>
                        <span class="badge bg-success">12 active</span>
                    </div>

                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Senior Product Designer</span>
                            <span class="text-success">Interview</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Frontend Engineer</span>
                            <span class="text-warning">Applied</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Product Manager</span>
                            <span class="text-primary">Follow-up</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2">
                            <span>UX Researcher</span>
                            <span class="text-muted">Wishlist</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4" id="features">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-number">01</div>
            <h4>Own the process</h4>
            <p>Track every role from wish list to offer, with no lost follow-ups.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-number">02</div>
            <h4>Stay in motion</h4>
            <p>Know exactly what to do next and keep your search moving forward.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-number">03</div>
            <h4>Make better decisions</h4>
            <p>Prioritize the right roles with a full picture of your pipeline and progress.</p>
        </div>
    </div>
</div>
