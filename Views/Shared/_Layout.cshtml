<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - JobTrackr</title><script type="importmap"></script><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/JobTrackr.styles.css" asp-append-version="true" /></head><body><header><nav class="navbar navbar-expand-lg navbar-dark tracker-nav mb-4"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Job<span>Trackr</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">@if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="Index">Applications</a></li><li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="Analytics">Analytics</a></li> }</ul><partial name="_LoginPartial" /></div></div></nav></header><div class="container pb-5">@if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }<main role="main">@RenderBody()</main></div><footer class="border-top footer text-muted"><div class="container">&copy; 2026 JobTrackr · Built for ambitious job seekers</div></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
