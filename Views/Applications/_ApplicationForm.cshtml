@model JobTrackr.Models.JobApplication
@using JobTrackr.Models
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="JobTitle" class="form-label"></label><input asp-for="JobTitle" class="form-control" /><span asp-validation-for="JobTitle" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ApplicationStatus>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" placeholder="Cape Town / Remote" /></div><div class="col-md-4"><label asp-for="Salary" class="form-label"></label><input asp-for="Salary" class="form-control" placeholder="R25k–R35k" /></div><div class="col-md-6"><label asp-for="ApplicationDate" class="form-label"></label><input asp-for="ApplicationDate" class="form-control" /></div><div class="col-md-6"><label asp-for="ClosingDate" class="form-label"></label><input asp-for="ClosingDate" class="form-control" /></div><div class="col-md-6"><label asp-for="RecruiterName" class="form-label"></label><input asp-for="RecruiterName" class="form-control" /></div><div class="col-md-6"><label asp-for="RecruiterEmail" class="form-label"></label><input asp-for="RecruiterEmail" class="form-control" /></div><div class="col-12"><label asp-for="JobDescription" class="form-label"></label><textarea asp-for="JobDescription" class="form-control" rows="5"></textarea></div></div>
