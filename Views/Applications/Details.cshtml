@model JobTrackr.Models.JobApplication
@{ ViewData["Title"] = Model.CompanyName; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><a asp-action="Index" class="text-decoration-none small">← All applications</a><h1 class="fw-bold mt-2 mb-1">@Model.JobTitle</h1><p class="text-muted fs-5">@Model.CompanyName · @(Model.Location ?? "Location not set")</p></div><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><form asp-action="Delete" asp-route-id="@Model.Id" class="d-inline" onsubmit="return confirm('Remove this application?')"><button class="btn btn-outline-danger">Delete</button></form></div></div>
<div class="row g-4"><div class="col-lg-8"><div class="detail-card mb-4"><div class="d-flex justify-content-between"><h5>Application overview</h5><span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></div><dl class="row mb-0 mt-3"><dt class="col-sm-4">Applied</dt><dd class="col-sm-8">@Model.ApplicationDate.ToString("dd MMMM yyyy")</dd><dt class="col-sm-4">Closing date</dt><dd class="col-sm-8">@(Model.ClosingDate?.ToString("dd MMMM yyyy") ?? "Not set")</dd><dt class="col-sm-4">Salary</dt><dd class="col-sm-8">@(Model.Salary ?? "Not set")</dd><dt class="col-sm-4">Recruiter</dt><dd class="col-sm-8">@(Model.RecruiterName ?? "Not set") @(Model.RecruiterEmail is not null ? $"· {Model.RecruiterEmail}" : "")</dd></dl>@if (!string.IsNullOrWhiteSpace(Model.JobDescription)) { <hr /><p class="mb-0 text-muted" style="white-space: pre-line">@Model.JobDescription</p> }</div>
<div class="detail-card"><h5>Interview timeline</h5>@if (Model.Interviews.Any()) { <div class="timeline mt-3">@foreach (var interview in Model.Interviews.OrderBy(x => x.ScheduledAt)) { <div class="timeline-item"><strong>@interview.ScheduledAt.ToString("ddd, dd MMM · HH:mm")</strong><div>@interview.Type</div><small class="text-muted">@interview.Notes</small></div>}</div> } else { <p class="text-muted mb-0">No interviews added yet.</p> }</div></div><div class="col-lg-4"><div class="detail-card mb-4"><h5>Add interview</h5><form asp-action="AddInterview" asp-route-id="@Model.Id" class="mt-3"><div class="mb-2"><input name="ScheduledAt" type="datetime-local" class="form-control" required /></div><div class="mb-2"><select name="Type" class="form-select"><option>Video</option><option>Phone</option><option>In person</option><option>Technical</option></select></div><textarea name="Notes" class="form-control mb-2" rows="3" placeholder="Preparation notes..."></textarea><button class="btn btn-primary w-100">Schedule interview</button></form></div><div class="detail-card"><h5>Documents</h5><form asp-action="Upload" asp-route-id="@Model.Id" enctype="multipart/form-data" class="mt-3"><select name="documentType" class="form-select mb-2"><option>CV</option><option>Cover Letter</option><option>Certificate</option></select><input name="file" type="file" accept=".pdf,.doc,.docx" class="form-control mb-2" required /><button class="btn btn-outline-primary w-100">Upload document</button></form>@if (Model.Documents.Any()) { <ul class="list-group list-group-flush mt-3">@foreach (var doc in Model.Documents) { <li class="list-group-item px-0"><small class="text-muted">@doc.DocumentType</small><br />@doc.OriginalFileName</li>}</ul> }</div></div></div>
