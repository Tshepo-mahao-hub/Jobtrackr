@model List<JobTrackr.Models.JobApplication>
@using JobTrackr.Models
@{ ViewData["Title"] = "Applications"; var companies = ViewBag.Companies as IEnumerable<string> ?? []; }
<div class="d-flex flex-wrap justify-content-between align-items-end mb-4"><div><p class="eyebrow text-primary mb-1">JOB PIPELINE</p><h1 class="fw-bold mb-0">Applications</h1></div><a class="btn btn-primary" asp-action="Create">+ Add application</a></div><form class="filter-card row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search company or role..." /></div><div class="col-md-3"><select class="form-select" name="status"><option value="">All statuses</option>@foreach (var value in Enum.GetValues<ApplicationStatus>()) { <option value="@value">@value</option> }</select></div><div class="col-md-3"><select class="form-select" name="company"><option value="">All companies</option>@foreach (var c in companies) { <option value="@c">@c</option> }</select></div><div class="col-md-1"><button class="btn btn-outline-primary w-100">Go</button></div></form>@if (!Model.Any()) { <div class="empty-state text-center py-5"><h3>No applications yet</h3><p class="text-muted">Your next opportunity starts with one small entry.</p><a asp-action="Create" class="btn btn-primary">Add your first application</a></div> } else { <div class="table-responsive application-table"><table class="table align-middle"><thead><tr><th>Company & role</th><th>Status</th><th>Applied</th><th>Closing</th><th></th></tr></thead><tbody>@foreach (var app in Model) { <tr><td><a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@app.Id">@app.CompanyName</a><div class="text-muted small">@app.JobTitle · @(app.Location ?? "Remote")</div></td><td><span class="status-pill status-@app.Status.ToString().ToLowerInvariant()">@app.Status</span></td><td>@app.ApplicationDate.ToString("dd MMM yyyy")</td><td>@(app.ClosingDate?.ToString("dd MMM yyyy") ?? "—")</td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@app.Id">Edit</a></td></tr>}</tbody></table></div> }
