@model JobTrackr.Models.DashboardViewModel
@using JobTrackr.Models
@{ ViewData["Title"] = "Analytics"; var max = Math.Max(1, Model.Applications.GroupBy(x => x.ApplicationDate.ToString("MMM")).Select(x => x.Count()).DefaultIfEmpty(1).Max()); }
<div class="mb-4"><p class="eyebrow text-primary mb-1">YOUR PROGRESS</p><h1 class="fw-bold">Analytics</h1><p class="text-muted">A clear view of your job-search momentum.</p></div><div class="row g-3 mb-5"><div class="col-6 col-lg"><div class="metric-card"><small>Total applications</small><strong>@Model.Total</strong></div></div><div class="col-6 col-lg"><div class="metric-card"><small>Interviews</small><strong>@Model.Interviews</strong></div></div><div class="col-6 col-lg"><div class="metric-card"><small>Offers</small><strong>@Model.Offers</strong></div></div><div class="col-6 col-lg"><div class="metric-card"><small>Pending</small><strong>@Model.Pending</strong></div></div><div class="col-6 col-lg"><div class="metric-card"><small>Success rate</small><strong>@Model.SuccessRate%</strong></div></div></div><div class="row g-4"><div class="col-lg-7"><div class="detail-card"><h5>Applications by month</h5><div class="bar-chart">@foreach(var group in Model.Applications.GroupBy(x => x.ApplicationDate.ToString("MMM")).OrderBy(x => x.First().ApplicationDate)) { <div class="bar-row"><span>@group.Key</span><div class="bar-track"><div class="bar" style="width:@(group.Count() * 100 / max)%"></div></div><b>@group.Count()</b></div>}@if (!Model.Applications.Any()) { <p class="text-muted mt-3">Add applications to unlock your analytics.</p> }</div></div></div><div class="col-lg-5"><div class="detail-card"><h5>Outcome breakdown</h5><div class="mt-3">@foreach(var status in Enum.GetValues<ApplicationStatus>()) { var count = Model.Applications.Count(x => x.Status == status); if (count > 0) { <div class="d-flex justify-content-between border-bottom py-2"><span>@status</span><strong>@count</strong></div> } }</div></div></div></div>
